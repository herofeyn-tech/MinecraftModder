<UserControl x:Class="MinecraftModder.Controls.PlayBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MinecraftModder.Controls"
             Width="160" Height="182" Cursor="Hand" Background="Transparent">
    <!-- Kullanıcının çizimindeki "ortada yükselen Oyna bloğu": izometrik bir çimen bloğu.
         Takılı diskin (aktif profil) bir kısmı bloğun arkasından görünür. -->
    <Canvas RenderOptions.BitmapScalingMode="NearestNeighbor">
        <Canvas x:Name="Lift" Canvas.Left="5" Canvas.Top="40">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="LiftTransform"/>
            </Canvas.RenderTransform>

            <!-- Takılı disk: bloğun arkasında, üst kenardan taşar -->
            <controls:DiscControl x:Name="MiniDisc" Width="74" Height="74" Canvas.Left="78" Canvas.Top="-40" SpinOnHover="False">
                <controls:DiscControl.RenderTransform>
                    <TranslateTransform x:Name="DiscSlide"/>
                </controls:DiscControl.RenderTransform>
            </controls:DiscControl>

            <!-- Üst yüz (çimen) -->
            <Path Data="M75,0 L150,38 L75,76 L0,38 Z" Stroke="#11131D" StrokeThickness="3" StrokeLineJoin="Round">
                <Path.Fill>
                    <ImageBrush x:Name="TopBrush">
                        <ImageBrush.RelativeTransform>
                            <TransformGroup>
                                <RotateTransform Angle="45" CenterX="0.5" CenterY="0.5"/>
                                <ScaleTransform ScaleX="0.7071" ScaleY="0.7071" CenterX="0.5" CenterY="0.5"/>
                            </TransformGroup>
                        </ImageBrush.RelativeTransform>
                    </ImageBrush>
                </Path.Fill>
            </Path>
            <Path x:Name="TopGlow" Data="M75,0 L150,38 L75,76 L0,38 Z" Fill="#33FFFFFF" Opacity="0" IsHitTestVisible="False"/>

            <!-- Sol yüz -->
            <Path Data="M0,38 L75,76 L75,140 L0,102 Z" Stroke="#11131D" StrokeThickness="3" StrokeLineJoin="Round">
                <Path.Fill>
                    <ImageBrush x:Name="LeftBrush">
                        <ImageBrush.RelativeTransform>
                            <MatrixTransform Matrix="1,0.37255,0,0.62745,0,0"/>
                        </ImageBrush.RelativeTransform>
                    </ImageBrush>
                </Path.Fill>
            </Path>
            <Path Data="M0,38 L75,76 L75,140 L0,102 Z" Fill="#30000000" IsHitTestVisible="False"/>

            <!-- Sağ yüz -->
            <Path Data="M75,76 L150,38 L150,102 L75,140 Z" Stroke="#11131D" StrokeThickness="3" StrokeLineJoin="Round">
                <Path.Fill>
                    <ImageBrush x:Name="RightBrush">
                        <ImageBrush.RelativeTransform>
                            <MatrixTransform Matrix="1,-0.37255,0,0.62745,0,0.37255"/>
                        </ImageBrush.RelativeTransform>
                    </ImageBrush>
                </Path.Fill>
            </Path>
            <Path Data="M75,76 L150,38 L150,102 L75,140 Z" Fill="#55000000" IsHitTestVisible="False"/>

            <!-- Üst yüzde yatan Oyna üçgeni -->
            <Path x:Name="PlayGlyph" Data="M58,25 L58,51 L98,38 Z" Fill="#F3F4FA" Stroke="#11131D" StrokeThickness="3" StrokeLineJoin="Round" IsHitTestVisible="False">
                <Path.RenderTransform>
                    <TranslateTransform Y="1"/>
                </Path.RenderTransform>
            </Path>
            <Border x:Name="StateBadge" Canvas.Left="20" Canvas.Top="24" Width="110" Height="28" Visibility="Collapsed" IsHitTestVisible="False"
                    Background="#E6191B28" CornerRadius="14" BorderBrush="#11131D" BorderThickness="2">
                <TextBlock x:Name="StateText" Foreground="#F3F4FA" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Canvas>
    </Canvas>
</UserControl>
