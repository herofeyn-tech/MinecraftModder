<UserControl x:Class="MinecraftModder.Views.BrowsePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="40,28,24,0">
        <!-- Başlık + uyumluluk bilgisi -->
        <Grid DockPanel.Dock="Top" Margin="0,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource H1}"/>
                <TextBlock x:Name="HintText" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
            <Grid Grid.Column="1" Width="340" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Padding="40,0,12,0" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource DimBrush}" Margin="14,0,0,0" IsHitTestVisible="False"/>
                <TextBlock x:Name="SearchPlaceholder" Text="Ara..." Foreground="{StaticResource DimBrush}" FontSize="14" Margin="42,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Grid>

        <!-- Tür ve kaynak seçimi -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <WrapPanel x:Name="KindChips"/>
            <Border x:Name="ChipDivider" Width="2" Height="22" Background="{StaticResource LineBrush}" Margin="6,0,14,8" VerticalAlignment="Center"/>
            <WrapPanel x:Name="ProviderChips"/>
        </WrapPanel>

        <Grid>
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" ScrollChanged="Scroller_ScrollChanged" PanningMode="VerticalOnly">
                <StackPanel Margin="0,8,0,40">
                    <ItemsControl x:Name="Cards" ItemsPanel="{StaticResource WrapPanelTemplate}"/>
                    <TextBlock x:Name="FooterText" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
