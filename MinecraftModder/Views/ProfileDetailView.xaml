<UserControl x:Class="MinecraftModder.Views.ProfileDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MinecraftModder"
             xmlns:controls="clr-namespace:MinecraftModder.Controls">
    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="26" BorderBrush="{StaticResource LineBrush}" BorderThickness="2"
            MaxWidth="1000" MaxHeight="660" Margin="40,30,40,90">
        <Grid Margin="26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sol: disk ve disk işlemleri -->
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <Grid Width="160" Height="160" HorizontalAlignment="Center">
                        <Ellipse Fill="#40000000" Margin="8,12,-4,-4"/>
                        <controls:DiscControl x:Name="Disc" AlwaysSpin="True"/>
                    </Grid>
                    <TextBlock Text="Disk adı" Style="{StaticResource Label}"/>
                    <TextBox x:Name="NameBox" FontWeight="Bold" LostFocus="NameBox_LostFocus" KeyDown="NameBox_KeyDown"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" Margin="2,6,0,12"/>

                    <Button x:Name="UseBtn" Style="{StaticResource GreenBtn}" Margin="0,0,0,10" Click="Use_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="UseBtnText" Text="Bu diski tak"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn}" Margin="0,0,0,10" Click="Repair_Click"
                            ToolTip="Eksik ya da bozulmuş dosyaları bulur ve sadece onları yeniden indirir.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE90F;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="Onar (Mod Doktoru)"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SoftBtn}" Margin="0,0,0,10" Click="OpenFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="Klasörünü aç"/>
                        </StackPanel>
                    </Button>

                    <Border Background="{StaticResource Surface2Brush}" CornerRadius="16" Padding="14" Margin="0,6,0,10">
                        <StackPanel>
                            <CheckBox x:Name="RamSwitch" Style="{StaticResource Switch}" Content="Bu diske özel RAM" Click="RamSwitch_Click"/>
                            <Grid x:Name="RamPanel" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="RamSlider" Minimum="1024" Maximum="8192" TickFrequency="512" IsSnapToTickEnabled="True" ValueChanged="RamSlider_ValueChanged"/>
                                <TextBlock x:Name="RamText" Grid.Column="1" Foreground="{StaticResource TextBrush}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="RamHint" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource GhostBtn}" Foreground="{StaticResource RedBrush}" HorizontalAlignment="Left" Click="Delete_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="Diski sil"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Sağ: içindekiler -->
            <DockPanel Grid.Column="2">
                <Grid DockPanel.Dock="Top">
                    <StackPanel>
                        <TextBlock Text="İçindekiler" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="SummaryText" Style="{StaticResource Muted}" Margin="0,4,40,12"/>
                    </StackPanel>
                    <Button Style="{StaticResource GhostBtn}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,-10,0" Click="Close_Click" ToolTip="Kapat (Esc)">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="16"/>
                    </Button>
                </Grid>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <CheckBox x:Name="SelectAll" Style="{StaticResource Tick}" Content="Tümünü seç" Margin="4,0,18,8" VerticalAlignment="Center" Click="SelectAll_Click"/>
                    <Button x:Name="EnableBtn" Content="Aç" Style="{StaticResource GreenBtn}" Padding="14,6" Margin="0,0,8,8" Click="Enable_Click"/>
                    <Button x:Name="DisableBtn" Content="Kapat" Style="{StaticResource SoftBtn}" Padding="14,6" Margin="0,0,8,8" Click="Disable_Click"/>
                    <Button x:Name="RemoveBtn" Content="Sil" Style="{StaticResource RedBtn}" Padding="14,6" Margin="0,0,8,8" Click="Remove_Click"/>
                    <Button Content="+ Mod ekle" Style="{StaticResource GhostBtn}" Padding="10,6" Margin="0,0,0,8" Click="AddMods_Click"/>
                </WrapPanel>

                <ListBox x:Name="Entries" SelectionMode="Multiple" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                         SelectionChanged="Entries_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{StaticResource Surface2Brush}" CornerRadius="14" Margin="0,0,6,6" Padding="12,8">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface3Brush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ContentEntryView}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource Tick}" VerticalAlignment="Center" IsHitTestVisible="False"
                                          IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}"/>
                                <Grid Grid.Column="1" Width="38" Height="38" local:RoundClip.Radius="10" Opacity="{Binding RowOpacity}">
                                    <Image Source="{Binding FallbackIcon}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    <Image Stretch="UniformToFill" local:AsyncImageLoader.SourceUrl="{Binding Entry.IconUrl}"/>
                                </Grid>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0" Opacity="{Binding RowOpacity}">
                                    <TextBlock Text="{Binding Entry.DisplayName}" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource DimBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="3" Background="{StaticResource RedBrush}" CornerRadius="8" Padding="7,2" Margin="0,0,12,0" VerticalAlignment="Center"
                                        Visibility="{Binding StateVisibility}" ToolTip="Dosya yok. 'Onar' ile geri getirilebilir.">
                                    <TextBlock Text="{Binding StateText}" Foreground="White" FontSize="10" FontWeight="Black"/>
                                </Border>
                                <CheckBox Grid.Column="4" Style="{StaticResource Switch}" VerticalAlignment="Center" Tag="{Binding}"
                                          IsChecked="{Binding Entry.Enabled, Mode=OneWay}" ToolTip="Açık / kapalı" Click="EntrySwitch_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
