<UserControl x:Class="MinecraftModder.Views.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MinecraftModder"
             xmlns:controls="clr-namespace:MinecraftModder.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
        <StackPanel Margin="40,28,24,40">
            <Grid Margin="0,0,16,24">
                <StackPanel>
                    <TextBlock Text="Disklerim" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                               Text="Her disk ayrı bir dünya: kendi Minecraft sürümü ve kendi modları. Bir diske tıkla, Oyna bloğuna takılsın; dişliye basıp içini düzenle."/>
                </StackPanel>
            </Grid>

            <ItemsControl x:Name="Discs" ItemsPanel="{StaticResource WrapPanelTemplate}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ProfileView}">
                        <Grid Width="190" Margin="0,0,22,28" Background="Transparent" Cursor="Hand"
                              MouseLeftButtonUp="Disc_Click" Tag="{Binding}" ToolTip="Tıkla: bu diski tak">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="190"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Takılı diskin arkasında yumuşak bir ışık -->
                            <Ellipse Width="186" Height="186" Visibility="{Binding ActiveVisibility}">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#8062C46F" Offset="0.6"/>
                                        <GradientStop Color="#0062C46F" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="160" Height="160" Fill="#40000000" Margin="6,10,0,0"/>
                            <controls:DiscControl Width="160" Height="160" Profile="{Binding Profile}"/>

                            <!-- Düzenle -->
                            <Button Style="{StaticResource Btn}" Background="{StaticResource Surface3Brush}" Foreground="{StaticResource TextBrush}"
                                    Padding="9" Margin="0,8,8,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Click="Edit_Click" Tag="{Binding}" ToolTip="Diski düzenle">
                                <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="14"/>
                            </Button>
                            <Border Background="{StaticResource GrassBrush}" CornerRadius="10" Padding="8,3" Margin="6,10,0,0"
                                    BorderBrush="{StaticResource OutlineBrush}" BorderThickness="2"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="{Binding ActiveVisibility}">
                                <TextBlock Text="TAKILI" FontSize="10" FontWeight="Black" Foreground="#0F2A14"/>
                            </Border>

                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <TextBlock Text="{Binding Profile.Name}" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis" MaxWidth="180" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="7,2" Margin="0,0,5,0">
                                        <TextBlock Text="{Binding Profile.DisplayVersion}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="{StaticResource OrangeBrush}" CornerRadius="8" Padding="7,2" Margin="0,0,5,0" Visibility="{Binding PackVisibility}">
                                        <TextBlock Text="PAKET" Foreground="#2A1A08" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource DimBrush}" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Yeni disk / paket dosyası -->
            <WrapPanel Margin="0,4,0,0">
                <Button Style="{StaticResource GreenBtn}" Padding="18,11" Click="NewDisc_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Yeni boş disk"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SoftBtn}" Padding="18,11" Click="ImportPack_Click"
                        ToolTip="Bilgisayarındaki bir Modrinth paketini (.mrpack) yeni bir disk olarak kurar.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Paket dosyası aç (.mrpack)"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
