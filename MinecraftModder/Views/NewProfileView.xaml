<UserControl x:Class="MinecraftModder.Views.NewProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MinecraftModder.Controls">
    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="26" BorderBrush="{StaticResource LineBrush}" BorderThickness="2"
            Width="520" Margin="0,0,0,90" Padding="28" VerticalAlignment="Center">
        <StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <controls:DiscControl x:Name="PreviewDisc" Width="64" Height="64" AlwaysSpin="True" Margin="0,0,16,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Yeni boş disk" Style="{StaticResource H1}"/>
                        <TextBlock Text="Kendi modlarını seçeceğin temiz bir dünya." Style="{StaticResource Muted}"/>
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource GhostBtn}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,-10,0" Click="Close_Click" ToolTip="Kapat (Esc)">
                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="16"/>
                </Button>
            </Grid>

            <TextBlock Text="Diskin adı" Style="{StaticResource Label}" Margin="0,22,0,6"/>
            <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged" KeyDown="NameBox_KeyDown"/>

            <TextBlock Text="Minecraft sürümü" Style="{StaticResource Label}"/>
            <ComboBox x:Name="VersionCombo"/>
            <TextBlock Text="Emin değilsen 1.20.1'de kal: modların çoğu bu sürümde." Style="{StaticResource Muted}" FontSize="11" Margin="2,6,0,0"/>

            <TextBlock Text="Mod çeşidi" Style="{StaticResource Label}"/>
            <WrapPanel x:Name="LoaderChips"/>
            <TextBlock x:Name="LoaderHint" Style="{StaticResource Muted}" FontSize="11" Margin="2,0,0,0"/>

            <Button x:Name="CreateBtn" Style="{StaticResource GreenBtn}" Margin="0,24,0,0" Padding="16,12" Click="Create_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                    <TextBlock Text="Diski oluştur ve tak"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
