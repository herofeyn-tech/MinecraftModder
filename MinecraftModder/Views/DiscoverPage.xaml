<UserControl x:Class="MinecraftModder.Views.DiscoverPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
        <StackPanel Margin="40,28,24,40">
            <TextBlock x:Name="GreetingText" Style="{StaticResource H1}" FontSize="30"/>
            <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,26"
                       Text="Her gün yeni bir seçki: beğendiğin kartın altındaki şeride bas, gerisini biz hallederiz."/>

            <!-- Favoriler (varsa) -->
            <StackPanel x:Name="FavoritesSection" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="&#xEB52;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource PinkBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Favorilerin" Style="{StaticResource H2}"/>
                </StackPanel>
                <ItemsControl x:Name="FavoriteCards" ItemsPanel="{StaticResource WrapPanelTemplate}" ItemTemplate="{StaticResource ModCardTemplate}" Margin="0,0,0,14"/>
            </StackPanel>

            <Grid Margin="0,0,16,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE734;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource YellowBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Bugünün 5 modu" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="ModsForText" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="12,0,0,2"/>
                </StackPanel>
                <Button Content="Tüm modlar  →" Style="{StaticResource GhostBtn}" HorizontalAlignment="Right" Click="AllMods_Click"/>
            </Grid>
            <ItemsControl x:Name="DailyMods" ItemsPanel="{StaticResource WrapPanelTemplate}" ItemTemplate="{StaticResource ModCardTemplate}" Margin="0,0,0,14"/>
            <TextBlock x:Name="DailyModsInfo" Style="{StaticResource Muted}" Margin="0,-6,0,20" Visibility="Collapsed"/>

            <Grid Margin="0,0,16,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource OrangeBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Bugünün 5 paketi" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="12,0,0,2" Text="her biri kendi diskine kurulur"/>
                </StackPanel>
                <Button Content="Tüm paketler  →" Style="{StaticResource GhostBtn}" HorizontalAlignment="Right" Click="AllPacks_Click"/>
            </Grid>
            <ItemsControl x:Name="DailyPacks" ItemsPanel="{StaticResource WrapPanelTemplate}" ItemTemplate="{StaticResource ModCardTemplate}" Margin="0,0,0,14"/>
            <TextBlock x:Name="DailyPacksInfo" Style="{StaticResource Muted}" Margin="0,-6,0,20" Visibility="Collapsed"/>

            <Grid Margin="0,0,16,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE706;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource SkyBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Dünyanı güzelleştir" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="12,0,0,2" Text="en sevilen shader'lar"/>
                </StackPanel>
                <Button Content="Tüm görünümler  →" Style="{StaticResource GhostBtn}" HorizontalAlignment="Right" Click="AllLooks_Click"/>
            </Grid>
            <ItemsControl x:Name="PopularShaders" ItemsPanel="{StaticResource WrapPanelTemplate}" ItemTemplate="{StaticResource LookCardTemplate}"/>
            <TextBlock x:Name="ShadersInfo" Style="{StaticResource Muted}" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
