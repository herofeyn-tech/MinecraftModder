<Window x:Class="MinecraftModder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MinecraftModder"
        xmlns:controls="clr-namespace:MinecraftModder.Controls"
        Title="Minecraft Modder" Height="780" Width="1200" MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBgBrush}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        Loaded="Window_Loaded" Closing="Window_Closing" SourceInitialized="Window_SourceInitialized" PreviewKeyDown="Window_PreviewKeyDown"
        AllowDrop="True" Drop="Window_Drop">
    <Window.Resources>
        <!-- Alt bardaki sekmeler: çizimdeki gibi yuvarlak tepeli "tepecikler"; seçili olan daha yüksek. -->
        <Style x:Key="NavTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="nav"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Root" Margin="3,14,3,0">
                            <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" CornerRadius="22,22,0,0"
                                    BorderBrush="{StaticResource OutlineBrush}" BorderThickness="2.5,2.5,2.5,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4"/>
                            </Border>
                            <Border x:Name="Cap" Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="40,6,40,0"
                                    VerticalAlignment="Top" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Margin" Value="3,10,3,0"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Margin" Value="3,2,3,0"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter TargetName="Cap" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ==================== GİRİŞ ==================== -->
        <Grid x:Name="LoginScreen">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                <Grid Width="170" Height="170" HorizontalAlignment="Center">
                    <Ellipse Fill="#40000000" Margin="8,12,-4,-4"/>
                    <controls:DiscControl x:Name="LoginDisc" AlwaysSpin="True"/>
                </Grid>
                <TextBlock Text="Minecraft Modder" Style="{StaticResource H1}" FontSize="34" HorizontalAlignment="Center" Margin="0,22,0,4"/>
                <TextBlock Text="Mod kurmanın en kolay yolu" Style="{StaticResource Muted}" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,28"/>

                <Border Style="{StaticResource Panel}" Padding="24">
                    <StackPanel>
                        <StackPanel x:Name="MsLoggedOutPanel">
                            <Button x:Name="MsLoginBtn" Style="{StaticResource GreenBtn}" Margin="0" Padding="16,12" Click="MsLoginBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Microsoft hesabıyla gir"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="MsLoggedInPanel" Visibility="Collapsed">
                            <TextBlock x:Name="RememberedText" Foreground="{StaticResource GrassBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <Button Style="{StaticResource GreenBtn}" Margin="0,0,0,8" Padding="16,12" Content="Bu hesapla devam et" Click="MsContinueBtn_Click"/>
                            <Button Style="{StaticResource GhostBtn}" Content="Başka hesap / hesabı unut" HorizontalAlignment="Center" Click="MsForgetBtn_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="LoginStatus" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,10,0,0"/>

                        <Grid Margin="0,16,0,16">
                            <Border Height="2" Background="{StaticResource LineBrush}" VerticalAlignment="Center"/>
                            <Border Background="{StaticResource SurfaceBrush}" Padding="12,0" HorizontalAlignment="Center">
                                <TextBlock Text="ya da" Foreground="{StaticResource DimBrush}" FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OfflineNameBox" MaxLength="16" Margin="0,0,10,0" KeyDown="OfflineNameBox_KeyDown"
                                     ToolTip="3-16 harf: İngilizce harf, rakam ya da _"/>
                            <Button Grid.Column="1" Style="{StaticResource SoftBtn}" Margin="0" Content="Çevrimdışı oyna" Click="OfflineLoginBtn_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ==================== ANA EKRAN ==================== -->
        <Grid x:Name="MainScreen" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="74"/>
            </Grid.RowDefinitions>

            <!-- Üst: kim, hangi disk takılı -->
            <Grid Margin="40,18,40,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Minecraft Modder" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="Black"/>
                    <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AccountText" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <Button x:Name="DiscPill" HorizontalAlignment="Right" Cursor="Hand" Click="DiscPill_Click" FocusVisualStyle="{x:Null}" ToolTip="Takılı disk: değiştirmek için tıkla">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" CornerRadius="22" Padding="6,6,16,6"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <controls:DiscControl x:Name="PillDisc" Width="32" Height="32"/>
                        <StackPanel Margin="10,0,12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PillName" Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="13"/>
                            <TextBlock x:Name="PillVersion" Foreground="{StaticResource DimBrush}" FontSize="11"/>
                        </StackPanel>
                        <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Button>
                <Popup x:Name="DiscPopup" PlacementTarget="{Binding ElementName=DiscPill}" Placement="Bottom" HorizontalOffset="-120"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="{StaticResource Surface2Brush}" CornerRadius="18" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5"
                            Padding="8" Margin="0,8,0,0" Width="320">
                        <StackPanel>
                            <TextBlock Text="Hangi diski takalım?" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="Bold" Margin="10,6,0,8"/>
                            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="PopupDiscs">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:ProfileView}">
                                            <Button Style="{StaticResource GhostBtn}" HorizontalContentAlignment="Stretch" Padding="8" Tag="{Binding}" Click="PopupDisc_Click">
                                                <Grid Width="270">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <controls:DiscControl Width="36" Height="36" Profile="{Binding Profile}"/>
                                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Profile.Name}" Foreground="{StaticResource TextBrush}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Profile.DisplayVersion}" Foreground="{StaticResource DimBrush}" FontSize="11"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{StaticResource GrassBrush}" Visibility="{Binding ActiveVisibility}"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Style="{StaticResource GhostBtn}" Content="Tüm disklerim  →" HorizontalAlignment="Right" Margin="0,4,0,0" Click="AllDiscs_Click"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- Sayfalar -->
            <Grid x:Name="PageHost" Grid.Row="1"/>

            <!-- Bilgi balonu: durum yazısı + ilerleme + iptal -->
            <Border x:Name="Toast" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="28,0,0,14" MaxWidth="380"
                    Background="{StaticResource Surface2Brush}" CornerRadius="16" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5"
                    Padding="16,12" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ToastText" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button x:Name="CancelBtn" Grid.Column="1" Style="{StaticResource GhostBtn}" Padding="8,4" Margin="10,-4,-8,-4" Content="İptal"
                                Visibility="Collapsed" Click="CancelBtn_Click"/>
                    </Grid>
                    <ProgressBar x:Name="BusyProgress" Height="6" Minimum="0" Maximum="1" Margin="0,10,0,0" Visibility="Collapsed"
                                 Background="{StaticResource Surface3Brush}" Foreground="{StaticResource GrassBrush}" BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- Alt bar: 3 sekme | Oyna bloğu | 3 sekme -->
            <Grid Grid.Row="2" Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="TabDiscover" Grid.Column="0" Style="{StaticResource NavTab}" Checked="Tab_Checked" Tag="Discover">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,8,0" Foreground="{StaticResource YellowBrush}"/>
                        <TextBlock Text="Keşfet"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabMods" Grid.Column="1" Style="{StaticResource NavTab}" Checked="Tab_Checked" Tag="Mods">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA86;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,8,0" Foreground="{StaticResource GrassBrush}"/>
                        <TextBlock Text="Modlar"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabPacks" Grid.Column="2" Style="{StaticResource NavTab}" Checked="Tab_Checked" Tag="Packs">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,8,0" Foreground="{StaticResource OrangeBrush}"/>
                        <TextBlock Text="Paketler"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabLooks" Grid.Column="4" Style="{StaticResource NavTab}" Checked="Tab_Checked" Tag="Looks">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE706;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,8,0" Foreground="{StaticResource SkyBrush}"/>
                        <TextBlock Text="Görünüm"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabDiscs" Grid.Column="5" Style="{StaticResource NavTab}" Checked="Tab_Checked" Tag="Discs">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="17" Height="17" Margin="0,0,8,0">
                            <Ellipse Stroke="{StaticResource PinkBrush}" StrokeThickness="2.2"/>
                            <Ellipse Width="5" Height="5" Fill="{StaticResource PinkBrush}"/>
                        </Grid>
                        <TextBlock Text="Disklerim"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabSettings" Grid.Column="6" Style="{StaticResource NavTab}" Checked="Tab_Checked" Tag="Settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="Ayarlar"/>
                    </StackPanel>
                </RadioButton>
            </Grid>

            <!-- Oyna bloğu: alt barın ortasından yükselir -->
            <controls:PlayBlock x:Name="PlayBlock" Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4"
                                Click="PlayBlock_Click"/>
        </Grid>

        <!-- ==================== DİSK DETAYI / YENİ DİSK (yakınlaşarak açılır) ==================== -->
        <Grid x:Name="OverlayLayer" Visibility="Collapsed" Background="#B3101220" MouseLeftButtonDown="OverlayLayer_MouseLeftButtonDown">
            <ContentControl x:Name="OverlayHost" RenderTransformOrigin="0.5,0.5" Focusable="False">
                <ContentControl.RenderTransform>
                    <ScaleTransform x:Name="OverlayScale"/>
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>

        <!-- ==================== SORU KUTUSU ==================== -->
        <Grid x:Name="DialogLayer" Visibility="Collapsed" Background="#B3101220">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="24" BorderBrush="{StaticResource LineBrush}" BorderThickness="2"
                    Width="460" Padding="26" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" Style="{StaticResource H2}" FontSize="20" TextWrapping="Wrap"/>
                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,10,0,22">
                        <TextBlock x:Name="DialogMessage" Style="{StaticResource Muted}" FontSize="14"/>
                    </ScrollViewer>
                    <StackPanel x:Name="DialogButtons" Orientation="Horizontal" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
