<Window x:Class="MinecraftModder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MinecraftModder"
        mc:Ignorable="d"
        Title="Modlu Başlatıcı" Height="680" Width="800" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Background="#202225">

        <!-- ==================== GİRİŞ EKRANI ==================== -->
        <Grid x:Name="LoginScreen" Visibility="Visible">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">
                <TextBlock Text="MİNECRAFT MODDER" Foreground="White" FontSize="28" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Oynamak için giriş yapmalısın" Foreground="#B9BBBE" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,40"/>

                <!-- XBOX Girişi (Orijinal) -->
                <Border Background="#2F3136" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Orijinal Hesap (Premium)" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                        <!-- Durum 1: Giriş Yapılmamış (Normal Buton) -->
                        <StackPanel x:Name="XboxLoggedOutPanel" Visibility="Visible">
                            <Button x:Name="XboxLoginBtn" Content="Xbox ile Giriş Yap" Height="40" Background="#107C10" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Click="XboxLoginBtn_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <!-- Durum 2: Hesap Hatırlanmış (Profil & Devam Et Butonu) -->
                        <StackPanel x:Name="XboxLoggedInPanel" Visibility="Collapsed">
                            <TextBlock x:Name="XboxRememberedUsername" Text="-" Foreground="#43B581" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <Button x:Name="XboxContinueBtn" Content="Bu Hesapla Oyna" Height="35" Background="#107C10" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Click="XboxContinueBtn_Click" Margin="0,0,0,10">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button x:Name="XboxLogoutBtn" Content="Farklı Hesapla Gir / Unut" Height="30" Background="#ED4245" Foreground="White" FontSize="12" FontWeight="Bold" BorderThickness="0" Click="XboxLogoutBtn_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <TextBlock x:Name="XboxLoginStatus" Text="" Foreground="#B9BBBE" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="VEYA" Foreground="#72767D" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Çevrimdışı (Crack) Girişi -->
                <Border Background="#2F3136" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Çevrimdışı Hesap (Offline)" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBox x:Name="OfflineUsernameBox" Height="35" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,10" Tag="Kullanıcı Adı" Text="Oyuncu"/>
                        <Button x:Name="OfflineLoginBtn" Content="Çevrimdışı Oyna" Height="40" Background="#7289DA" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Click="OfflineLoginBtn_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>


        <!-- ==================== ANA EKRAN (MEVCUT UYGULAMA) ==================== -->
        <Grid x:Name="MainScreen" Visibility="Collapsed">
            <TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0" Margin="20" SelectionChanged="MainTabControl_SelectionChanged">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="#2F3136"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0" Padding="16,8" Margin="0,0,2,0">
                                        <ContentPresenter x:Name="Content" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#7289DA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Kart Stilleri -->
                    <Style x:Key="SearchCardListBoxItemStyle" TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="6"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#7289DA"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#40444B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="InstalledCardListBoxItemStyle" TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="6"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- SEKME 1: MOD ARA -->
                <TabItem Header="Mod Ara">
                    <Grid Background="#202225">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="600">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                                <TextBlock x:Name="WelcomeText" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,10,0" Text="Hoş Geldin!"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                                <TextBox x:Name="SearchBox" Width="400" Height="35" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                                <Button x:Name="SearchBtn" Content="Mod Ara" Width="90" Height="35" Background="#7289DA" Foreground="White" BorderThickness="0" Click="SearchBtn_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>

                            <ListBox x:Name="ModListBox" Height="270" Width="600" Margin="0,0,0,15" Background="#2F3136" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="ModListBox_MouseDoubleClick">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource SearchCardListBoxItemStyle}"/>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="110" Height="130" Padding="8">
                                            <Grid>
                                                <StackPanel>
                                                    <Border Width="64" Height="64" CornerRadius="6" ClipToBounds="True" HorizontalAlignment="Center" Background="#202225">
                                                        <Image local:AsyncImageLoader.SourceUrl="{Binding icon_url}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding title}" Foreground="White" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxHeight="45" Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <Border Background="#FAA61A" CornerRadius="4" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding project_type}" Value="modpack">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="PACK" FontSize="8" FontWeight="Bold" Foreground="Black"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="StatusText" Text="Oynamaya Hazır!" Foreground="#B9BBBE" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,15" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                            <ProgressBar x:Name="DownloadProgressBar" Height="20" Minimum="0" Maximum="100" Margin="0,0,0,15"/>
                            <Button x:Name="DownloadBtn" Content="Oyunu Başlat ve Modları Yükle" Width="250" Height="45" FontSize="15" FontWeight="Bold" Background="#43B581" Foreground="White" BorderThickness="0" Click="DownloadBtn_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- SEKME 2: KURULU MODLAR -->
                <TabItem Header="Kurulu Modlar">
                    <Grid Background="#202225">

                        <!-- ANA LİSTE GÖRÜNÜMÜ -->
                        <StackPanel x:Name="InstalledMainView" Width="640" Margin="0,20,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="Kurulu Modlar ve Paketler" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="Paketlere çift tıklayarak içindeki modları görebilirsin." Foreground="#B9BBBE" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Button x:Name="RefreshModsBtn" Content="Listeyi Yenile" Width="130" Height="32" Background="#7289DA" Foreground="White" BorderThickness="0" Margin="0,0,10,0" Click="RefreshModsBtn_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <TextBlock x:Name="InstalledStatusText" Text="" Foreground="#B9BBBE" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ListBox x:Name="InstalledModsListBox" Height="440" Width="640" Margin="0,0,0,15" Background="#2F3136" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="InstalledModsListBox_MouseDoubleClick">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource SearchCardListBoxItemStyle}"/>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="118" Height="168" Background="#36393F" CornerRadius="8" Padding="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0">
                                                    <Border Width="64" Height="64" CornerRadius="6" ClipToBounds="True" HorizontalAlignment="Center" Background="#202225">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                        <Setter Property="Opacity" Value="0.35"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Image local:AsyncImageLoader.SourceUrl="{Binding IconUrl}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxHeight="45" Margin="0,6,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                        <Setter Property="Foreground" Value="#72767D"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding SubText}" Foreground="#B9BBBE" FontSize="10" TextAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <Border x:Name="PackBadge" Background="#FAA61A" CornerRadius="4" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-4,0,0" Visibility="Collapsed">
                                                    <TextBlock Text="PACK" FontSize="8" FontWeight="Bold" Foreground="Black"/>
                                                </Border>

                                                <Grid x:Name="ControlsPanel" Grid.Row="1" Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="{Binding IsEnabled, Mode=OneWay}" Click="ModEnabledCheckBox_Click" Tag="{Binding}" ToolTip="Aktif / Pasif"/>
                                                    <Button Grid.Column="1" Content="✕" Width="22" Height="22" FontSize="10" Padding="0" Background="#ED4245" Foreground="White" BorderThickness="0" Click="DeleteModBtn_Click" Tag="{Binding}" ToolTip="Sil">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="4"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsPack}" Value="True">
                                                <Setter TargetName="PackBadge" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <!-- DETAY (MODPACK İÇİ) GÖRÜNÜMÜ -->
                        <StackPanel x:Name="ModpackDetailView" Width="640" Margin="0,20,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                            <Grid Margin="0,0,0,15">
                                <Button Content="← Geri" Width="70" Height="30" Background="#4F545C" Foreground="White" BorderThickness="0" HorizontalAlignment="Left" Click="BackToMainInstalledView_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <TextBlock x:Name="DetailPackTitle" Text="Paket Adı" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <ListBox x:Name="ModpackDetailListBox" Height="440" Width="640" Background="#2F3136" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource InstalledCardListBoxItemStyle}"/>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="118" Height="168" Background="#36393F" CornerRadius="8" Padding="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0">
                                                    <Border Width="64" Height="64" CornerRadius="6" ClipToBounds="True" HorizontalAlignment="Center" Background="#202225">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                        <Setter Property="Opacity" Value="0.35"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Image local:AsyncImageLoader.SourceUrl="{Binding IconUrl}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxHeight="45" Margin="0,6,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                        <Setter Property="Foreground" Value="#72767D"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="{Binding IsEnabled, Mode=OneWay}" Click="ModEnabledCheckBox_Click" Tag="{Binding}" ToolTip="Aktif / Pasif"/>
                                                    <Button Grid.Column="1" Content="✕" Width="22" Height="22" FontSize="10" Padding="0" Background="#ED4245" Foreground="White" BorderThickness="0" Click="DeleteModBtn_Click" Tag="{Binding}" ToolTip="Sil">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="4"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
