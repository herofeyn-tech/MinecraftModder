<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:MinecraftModder">

    <!-- ===== Renkler: gece mavisi zemin, yumuşak pastel vurgular. Göz yormasın diye saf siyah/beyaz yok. ===== -->
    <Color x:Key="BgColor">#191B28</Color>
    <Color x:Key="Bg2Color">#21243A</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#191B28"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#252940"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#2E334D"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#3A4060"/>
    <SolidColorBrush x:Key="LineBrush" Color="#3A3F5C"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="#11131D"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F3F4FA"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A9AEC9"/>
    <SolidColorBrush x:Key="DimBrush" Color="#6F7594"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#8394FF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2F3768"/>
    <SolidColorBrush x:Key="GrassBrush" Color="#62C46F"/>
    <SolidColorBrush x:Key="GrassDarkBrush" Color="#3F9450"/>
    <SolidColorBrush x:Key="PinkBrush" Color="#FF7A98"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="#FFA94D"/>
    <SolidColorBrush x:Key="YellowBrush" Color="#FFD45E"/>
    <SolidColorBrush x:Key="RedBrush" Color="#F2626B"/>
    <SolidColorBrush x:Key="SkyBrush" Color="#8FD3F4"/>
    <SolidColorBrush x:Key="StripBrush" Color="#EEF1FB"/>

    <LinearGradientBrush x:Key="WindowBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1E2135" Offset="0"/>
        <GradientStop Color="#171926" Offset="1"/>
    </LinearGradientBrush>

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- ===== Yazılar ===== -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,14,0,6"/>
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== Butonlar: yuvarlak, hafif kabarık; üstüne gelince biraz yükselir ===== -->
    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="#141626"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border Background="#33000000" CornerRadius="12" Margin="0,3,0,-3"/>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="-1"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="2"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource GrassBrush}"/>
    </Style>
    <Style x:Key="RedBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource RedBrush}"/>
    </Style>
    <Style x:Key="SoftBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource Surface3Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <!-- Sadece ikon/yazıdan oluşan, arka planı olmayan buton -->
    <Style x:Key="GhostBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Seçilebilir küçük hap (kaynak, tür, loader seçimi) -->
    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="16" Padding="14,6">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="#141626"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Aç/kapa anahtarı -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="42" Height="24" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="12" Background="{StaticResource Surface3Brush}"/>
                            <Ellipse x:Name="Knob" Width="18" Height="18" Fill="#F3F4FA" HorizontalAlignment="Left" Margin="3,0"/>
                        </Grid>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource GrassBrush}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Seçim kutusu (çoklu seçim listelerinde) -->
    <Style x:Key="Tick" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="22" Height="22" CornerRadius="7" BorderThickness="2" BorderBrush="{StaticResource LineBrush}" Background="{StaticResource SurfaceBrush}">
                            <TextBlock x:Name="Mark" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="#141626" HorizontalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Metin kutusu ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Açılır liste (sürüm seçimi) ===== -->
    <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
        <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="12">
            <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" Margin="0,0,12,0"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Template="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter Margin="14,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5" CornerRadius="12"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300" Margin="0,4,0,0" Padding="4">
                                <ScrollViewer>
                                    <StackPanel IsItemsHost="True"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface3Brush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Kaydırıcı ===== -->
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse Width="20" Height="20" Fill="#F3F4FA" Stroke="{StaticResource AccentBrush}" StrokeThickness="3"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="24">
                        <Border Height="8" CornerRadius="4" Background="{StaticResource Surface3Brush}" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="8" CornerRadius="4" Background="{StaticResource AccentBrush}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== İnce, yuvarlak kaydırma çubuğu ===== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="4" Background="#55A9AEC9" Margin="2"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Background="#55A9AEC9" Margin="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="MaxWidth" Value="320"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Yükseltilmiş yüzey (panel, form) -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- ================================================================
         MOD KARTI (kullanıcının çizimi): dikey kart, bulanık oyun görüntüsü
         zemin, ortada ikon, sol üstte PAKET, sağ üstte kaynak rozeti, altta
         indirme şeridi (kurulunca yeşil + tik), altında kalp + isim + indirme.
         ================================================================ -->
    <DataTemplate x:Key="ModCardTemplate" DataType="{x:Type local:CardViewModel}">
        <Grid x:Name="CardRoot" Width="176" Margin="0,0,18,22" Background="Transparent" ToolTip="{Binding Tooltip}">
            <Grid.RowDefinitions>
                <RowDefinition Height="230"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Gölge -->
            <Border CornerRadius="22" Background="#40000000" Margin="2,6,-2,-6"/>

            <Border x:Name="Tile" CornerRadius="22" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="3">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding FallbackBanner}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Linear"/>
                </Border.Background>
                <Grid local:RoundClip.Radius="19">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>
                    <!-- Bulanık görüntü: küçük çözülüp büyütülerek (ucuz bulanıklık) -->
                    <Image Grid.RowSpan="2" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Linear"
                           local:AsyncImageLoader.DecodeWidth="28" local:AsyncImageLoader.SourceUrl="{Binding Item.BannerUrl}"/>
                    <Border Grid.RowSpan="2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#10000000" Offset="0"/>
                                <GradientStop Color="#55000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- İkon -->
                    <Border Width="84" Height="84" CornerRadius="20" BorderBrush="#F3F4FA" BorderThickness="3" Background="{StaticResource SurfaceBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0">
                        <Grid local:RoundClip.Radius="17">
                            <Image Source="{Binding FallbackIcon}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <Image Stretch="UniformToFill" local:AsyncImageLoader.SourceUrl="{Binding Item.IconUrl}"/>
                        </Grid>
                    </Border>

                    <!-- PAKET etiketi -->
                    <Border Background="{StaticResource OrangeBrush}" CornerRadius="8" Padding="8,3" Margin="12,12,0,0"
                            BorderBrush="{StaticResource OutlineBrush}" BorderThickness="2"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="{Binding PackVisibility}">
                        <TextBlock Text="PAKET" FontSize="10" FontWeight="Black" Foreground="#2A1A08"/>
                    </Border>

                    <!-- Kaynak rozeti -->
                    <Border Width="24" Height="24" CornerRadius="7" Background="{Binding ProviderBrush}" Margin="0,12,12,0"
                            BorderBrush="{StaticResource OutlineBrush}" BorderThickness="2"
                            HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="{Binding ProviderName}">
                        <TextBlock Text="{Binding ProviderLetter}" FontSize="11" FontWeight="Black" Foreground="#141626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- İndirme şeridi -->
                    <Button Grid.Row="1" Command="{Binding InstallCommand}" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="{Binding ActionTooltip}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Strip" Background="{StaticResource StripBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,3,0,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Strip" Property="Background" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="{Binding ActionGlyph}" Style="{StaticResource Icon}" FontSize="18" FontWeight="Bold" Foreground="#5C6280"/>
                    </Button>
                    <!-- Kurulu: yeşil şerit + tik -->
                    <Border Grid.Row="1" Background="{StaticResource GrassBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,3,0,0"
                            Visibility="{Binding InstalledVisibility}" ToolTip="Bu profilde kurulu">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>
                    <!-- Kuruluyor -->
                    <Border Grid.Row="1" Background="{StaticResource YellowBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,3,0,0"
                            Visibility="{Binding BusyVisibility}">
                        <TextBlock Text="Kuruluyor..." FontWeight="Bold" FontSize="12" Foreground="#3A2A00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Kalp + isim + indirme sayısı -->
            <Grid Grid.Row="1" Margin="2,10,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource GhostBtn}" Padding="2" Margin="0,0,6,0" VerticalAlignment="Top" Command="{Binding FavoriteCommand}" ToolTip="Favorilere ekle">
                    <TextBlock Text="{Binding HeartGlyph}" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource PinkBrush}"/>
                </Button>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Item.Title}" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource DimBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                <Setter TargetName="CardRoot" Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="-4"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================================================================
         GÖRÜNÜM KARTI (shader / kaynak paketi): geniş, görüntü NET ve büyük;
         amaç karşılaştırmak.
         ================================================================ -->
    <DataTemplate x:Key="LookCardTemplate" DataType="{x:Type local:CardViewModel}">
        <Grid x:Name="CardRoot" Width="300" Margin="0,0,18,22" Background="Transparent" ToolTip="{Binding Tooltip}">
            <Grid.RowDefinitions>
                <RowDefinition Height="200"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border CornerRadius="22" Background="#40000000" Margin="2,6,-2,-6"/>
            <Border CornerRadius="22" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="3">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding FallbackBanner}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border.Background>
                <Grid local:RoundClip.Radius="19">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>
                    <Image Grid.RowSpan="2" Stretch="UniformToFill" local:AsyncImageLoader.DecodeWidth="420" local:AsyncImageLoader.SourceUrl="{Binding Item.BannerUrl}"/>
                    <Border Width="44" Height="44" CornerRadius="12" BorderBrush="#F3F4FA" BorderThickness="2.5" Background="{StaticResource SurfaceBrush}"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,10">
                        <Image Stretch="UniformToFill" local:RoundClip.Radius="9" local:AsyncImageLoader.SourceUrl="{Binding Item.IconUrl}"/>
                    </Border>
                    <Border Width="24" Height="24" CornerRadius="7" Background="{Binding ProviderBrush}" Margin="0,12,12,0"
                            BorderBrush="{StaticResource OutlineBrush}" BorderThickness="2"
                            HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="{Binding ProviderName}">
                        <TextBlock Text="{Binding ProviderLetter}" FontSize="11" FontWeight="Black" Foreground="#141626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Button Grid.Row="1" Command="{Binding InstallCommand}" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="{Binding ActionTooltip}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Strip" Background="{StaticResource StripBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,3,0,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Strip" Property="Background" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="{Binding ActionGlyph}" Style="{StaticResource Icon}" FontSize="18" FontWeight="Bold" Foreground="#5C6280"/>
                    </Button>
                    <Border Grid.Row="1" Background="{StaticResource GrassBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,3,0,0"
                            Visibility="{Binding InstalledVisibility}" ToolTip="Bu profilde kurulu">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="1" Background="{StaticResource YellowBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,3,0,0"
                            Visibility="{Binding BusyVisibility}">
                        <TextBlock Text="Kuruluyor..." FontWeight="Bold" FontSize="12" Foreground="#3A2A00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="2,10,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource GhostBtn}" Padding="2" Margin="0,0,6,0" VerticalAlignment="Top" Command="{Binding FavoriteCommand}" ToolTip="Favorilere ekle">
                    <TextBlock Text="{Binding HeartGlyph}" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource PinkBrush}"/>
                </Button>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Item.Title}" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource DimBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                <Setter TargetName="CardRoot" Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="-4"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Kart ızgarası için ItemsControl paneli -->
    <ItemsPanelTemplate x:Key="WrapPanelTemplate">
        <WrapPanel Orientation="Horizontal"/>
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="RowPanelTemplate">
        <StackPanel Orientation="Horizontal"/>
    </ItemsPanelTemplate>
</ResourceDictionary>
